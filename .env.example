# California Housing Intelligence Platform - Environment Configuration

# Application Environment ('development' or 'production')
ENVIRONMENT=development

# Project & Security
PROJECT_NAME="California Housing Intelligence Platform"
# In production, JWT_SECRET must be set to a secure random string (minimum 32 characters)
JWT_SECRET="replace-with-a-secure-random-32-byte-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated list of allowed origin URLs)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"

# Database (Defaults to local high-performance SQLite)
DATABASE_URL="sqlite:///./data/housing.db"

# Google Gemini AI Integration (Optional)
# If left empty, the platform automatically activates its calibrated deterministic analytical fallback engine.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Server Host and Port
PORT=8000
HOST="0.0.0.0"
